# Copie para .env e preencha

PORT=3333
BRIDGE_SECRET=troque-este-segredo

# URL pública deste bridge (obrigatória para webhook da Meta)
# Local: use ngrok → https://xxxx.ngrok-free.app
PUBLIC_BRIDGE_URL=http://localhost:3333

# ——— WhatsApp Cloud API (Meta) — RECOMENDADO ———
# Guia: docs/CRM-WHATSAPP-CLOUD.md
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=socialexpress-verify-troque
# Opcional
# META_APP_SECRET=

# ——— Evolution (legado / opcional) ———
# Só use se NÃO configurar META_*. Se META_* estiver preenchido, o Meta tem prioridade.
# EVOLUTION_BASE_URL=https://SEU-PROJETO.up.railway.app
# EVOLUTION_API_KEY=sua-api-key-global
# EVOLUTION_INSTANCE=social-express
