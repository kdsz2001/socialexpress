# Copie para .env e preencha após criar a Evolution no Railway
PORT=3333
BRIDGE_SECRET=troque-este-segredo

# URL pública da Evolution no Railway (sem barra no final)
EVOLUTION_BASE_URL=https://SEU-PROJETO.up.railway.app
EVOLUTION_API_KEY=sua-api-key-global
EVOLUTION_INSTANCE=social-express

# URL pública deste bridge (para a Evolution mandar webhooks)
# Em local com tunnel: https://xxxx.ngrok.app
PUBLIC_BRIDGE_URL=http://localhost:3333
